POSTGRES_DB=panaderia
POSTGRES_USER=panaderia
POSTGRES_PORT=55432
# Sustituir ambos valores antes de iniciar. Usar caracteres seguros para una URL o codificarlos en DATABASE_URL.
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_DB
DATABASE_URL=postgresql://panaderia:CAMBIAR_PASSWORD_DB@127.0.0.1:55432/panaderia

API_PORT=3000
WEB_PORT=5174
BETTER_AUTH_URL=http://127.0.0.1:5174
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=CAMBIAR_SECRET
BAKERY_NAME="Mi Panadería"
BAKERY_TIME_ZONE=America/Mexico_City
# Solo para db:seed. Usar una contraseña única de 12 a 128 caracteres.
SEED_ADMIN_PASSWORD=

# Producción (compose.prod.yml): URL HTTPS pública y puerto local del proxy inverso.
# BETTER_AUTH_URL=https://caja.example.com
# APP_PORT=18080
